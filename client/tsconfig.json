{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@mahjong-live/shared/single": ["../shared/src/engine/single/index.ts"],
      "@mahjong-live/shared/rules": ["../shared/src/engine/rules/index.ts"],
      "@mahjong-live/shared/match": ["../shared/src/engine/match/index.ts"],
      "@mahjong-live/shared/tile-types": ["../shared/src/engine/tiles/types.ts"]
    }
  },
  "include": ["src"]
}
